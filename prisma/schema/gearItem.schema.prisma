model GearItem {
  id           String            @id @default(uuid())
  name         String
  description  String
  brand        String?
  pricePerDay  Decimal           @db.Decimal(10, 2)
  stock        Int               @default(1)
  availability GearAvailability  @default(AVAILABLE)
  images       String[]
  providerId   String
  categoryId   String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt


  provider     User              @relation("ProviderGear", fields: [providerId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id])
  rentalItems  RentalOrderItem[]
  reviews      Review[]

  @@index([providerId])
  @@index([categoryId])
  @@index([availability])
  @@index([brand])
}