  "item": [
    {
      "name": "Auth",
      "description": "Public register/login + get current profile. Login/Register auto-save the returned JWT into collection variables (accessToken + role-specific *Token vars).",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "role must be CUSTOMER or PROVIDER (ADMIN is seeded separately via SUPER_ADMIN env vars).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer\",\n  \"email\": \"john.customer@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"phone\": \"01700000000\",\n  \"address\": \"Dhaka, Bangladesh\",\n  \"role\": \"CUSTOMER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "    const json = pm.response.json();",
                  "    const token = json?.data?.token;",
                  "    const user = json?.data?.user;",
                  "    if (token) {",
                  "        pm.collectionVariables.set(\"accessToken\", token);",
                  "        if (user?.role === \"CUSTOMER\") pm.collectionVariables.set(\"customerToken\", token);",
                  "        if (user?.role === \"PROVIDER\") pm.collectionVariables.set(\"providerToken\", token);",
                  "        if (user?.role === \"ADMIN\") pm.collectionVariables.set(\"adminToken\", token);",
                  "    }",
                  "    if (user?.id) pm.collectionVariables.set(\"userId\", user.id);",
                  "}"
                ]
              }
            }
          ]
        },
